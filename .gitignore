# --- Model artifacts (generated locally) ---
*.pth
*.ckpt
checkpoints/

# NOTE: *.pt is NOT globally ignored here — the shipped victim checkpoints
# in results/ are part of the release artifact (v2x_redteam.py evaluate and
# the 3-seed protocol need them; ~8 MB total; all configs recorded in the
# result JSONs). If you add throwaway .pt files, delete them explicitly.

# dataset cache (regenerable deterministically via build_dataset(seed, n))
results/dataset_cache/

